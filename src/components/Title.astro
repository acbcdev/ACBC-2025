<!-- Figma spec scaled 1.29x (28px → 36px pill), radial white/12 + noise/14, 5-layer outer shadow -->
<h2
  class="relative isolate flex h-9 w-fit items-center rounded-full pl-4 pr-5 text-lg font-medium uppercase bg-[radial-gradient(100%_100%_at_50%_0%,rgba(255,255,255,0.12),transparent)] shadow-[0_-1px_0_rgba(255,255,255,0.06),0_0_0_1px_rgba(255,255,255,0.06),0_0_1px_1.5px_rgba(0,0,0,0.24),0_0_0_1px_#27272a,0_2px_2px_rgba(0,0,0,0.24)] before:absolute before:inset-0 before:-z-10 before:rounded-full before:bg-[url(/noise.png)] before:bg-size-[14.2px] before:opacity-[0.14]"
>
  <span
    class="flex items-center gap-[13px] leading-none bg-linear-to-b from-white/70 from-9% to-white bg-clip-text text-transparent [&_svg]:size-4"
  >
    <slot />
  </span>
</h2>
