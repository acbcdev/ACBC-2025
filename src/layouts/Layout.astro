---
import Analytics from "@vercel/analytics/astro";
import SEO from "@/components/SEO.astro";
import "@fontsource-variable/geist";
import "@/styles/globals.css";
type Props = {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
};
const { title, description, image = "/og.jpg", canonical } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
    />
  </head>
  <body class="overflow-x-hidden w-full">
    <div
      class="w-[100%] md:w-[70%] lg:w-[60%] xl:w-[55%] mx-auto grid place-content-center"
    >
      <slot />
    </div>
    <Analytics />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }
</style>
