---
import GithubSvg from "@/svg/github.svg";
import LinkedinSvg from "@/svg/linkedin.svg";
import Button from "@/components/Button.astro";
---

<section class="mt-32 mb-20 flex flex-col px-4 items-start gap-y-6">
  <h1 class="text-3xl font-extrabold leading-none tracking-tight">
    Hi<br />I'm Camilo Blandon
  </h1>
  <p class="text-muted-foreground text-lg max-w-[65ch] text-pretty">
    I'm a fullstack developer building scalable, high-quality applications with
    React, Next.js, and TypeScript. I focus on performance, responsive design,
    and maintainable code.
  </p>

  <footer class="flex flex-wrap gap-3">
    <Button href="https://www.linkedin.com/in/acbc-dev/">
      Linkedin <LinkedinSvg />
    </Button>
    <Button href="https://github.com/acbcdev">
      Github <GithubSvg />
    </Button>
  </footer>
</section>
