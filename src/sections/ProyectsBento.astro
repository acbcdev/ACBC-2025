---
import Terminal from "@/svg/terminal.svg";
import GithubSvg from "@/svg/github.svg";
import ArrowSvg from "@/svg/arrow-up-right.svg";
import { projects } from "@/const/projects";
import Title from "@/components/Title.astro";
---

<section class="my-20 px-4 grid gap-8">
  <Title>
    <Terminal /> Projects
  </Title>

  <!-- ponytail: CSS scroll-snap carousel, no Embla -->
  <div
    id="projects-track"
    class="flex gap-6 overflow-x-auto snap-x snap-mandatory [scrollbar-width:none]"
  >
    {
      projects.map((p) => (
        <article class="glass-border snap-start shrink-0 basis-full md:basis-[calc(50%-0.75rem)] flex flex-col rounded-xl backdrop-blur-[6px] bg-[radial-gradient(50%_50%_at_50%_50%,rgb(255_255_255/0.12),transparent)]">
          <div class="glass-border rounded-xl overflow-hidden">
            <img
              src={p.img}
              alt={`${p.name} screenshot`}
              class="aspect-[2.13/1] w-full object-cover object-top"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col gap-3 p-3">
            <header class="flex items-center justify-between gap-2">
              <h3 class="text-2xl font-semibold text-fade">{p.name}</h3>
              <div class="flex gap-3 text-zinc-100 [&_svg]:size-5">
                <a
                  href={p.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="GitHub repository"
                  class="opacity-90 hover:opacity-100 transition-opacity"
                >
                  <GithubSvg />
                </a>
                {p.link && (
                  <a
                    href={p.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Live site"
                    class="opacity-90 hover:opacity-100 transition-opacity"
                  >
                    <ArrowSvg />
                  </a>
                )}
              </div>
            </header>
            <p class="text-lg line-clamp-4 text-fade" title={p.description}>
              {p.description.trim()}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <nav
    id="projects-dots"
    class="flex justify-center gap-2.5"
    aria-label="Projects pages"
  >
  </nav>
</section>

<style>
  /* white/5 border + top-left highlight, like Figma double stroke */
  .glass-border {
    position: relative;
  }
  .glass-border::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    z-index: 1;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.12) 10%, transparent 40%),
      rgb(255 255 255 / 0.05);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }
  /* vertical white 70% -> 100% text fill */
  .text-fade {
    background: linear-gradient(rgb(255 255 255 / 0.7), #fff);
    background-clip: text;
    color: transparent;
  }
  /* dots are created in JS, so plain CSS instead of Tailwind classes the scanner may miss */
  #projects-dots :global(.dot) {
    position: relative;
    isolation: isolate;
    display: grid;
    place-content: center;
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    background: radial-gradient(
      100% 100% at 50% 0%,
      rgb(255 255 255 / 0.12),
      transparent
    );
    box-shadow:
      0 -1px 0 rgb(255 255 255 / 0.06),
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 0 1px 1.5px rgb(0 0 0 / 0.24),
      0 0 0 1px #27272a,
      0 2px 2px rgb(0 0 0 / 0.24);
  }
  #projects-dots :global(.dot)::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: url(/noise.png) 0 0 / 14.2px;
    opacity: 0.14;
  }
  #projects-dots :global(.dot)::after {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: linear-gradient(rgb(255 255 255 / 0.7), #fff);
    opacity: 0;
    transition: opacity 150ms;
  }
  #projects-dots :global(.dot[data-active])::after {
    opacity: 1;
  }
</style>

<script>
  const track = document.getElementById("projects-track")!;
  const dotsNav = document.getElementById("projects-dots")!;
  const cards = [...track.children] as HTMLElement[];
  let dots: HTMLButtonElement[] = [];

  const perPage = () =>
    Math.max(1, Math.round(track.clientWidth / cards[0].offsetWidth));

  function render() {
    const pages = Math.ceil(cards.length / perPage());
    dotsNav.innerHTML = "";
    dots = Array.from({ length: pages }, (_, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.ariaLabel = `Page ${i + 1}`;
      b.className = "dot";
      b.onclick = () =>
        track.scrollTo({
          left: cards[i * perPage()].offsetLeft - track.offsetLeft,
          behavior: "smooth",
        });
      dotsNav.append(b);
      return b;
    });
    update();
  }

  function update() {
    const max = track.scrollWidth - track.clientWidth;
    const page =
      track.scrollLeft >= max - 2
        ? dots.length - 1
        : Math.round(track.scrollLeft / (cards[0].offsetWidth * perPage()));
    dots.forEach((d, i) => d.toggleAttribute("data-active", i === page));
  }

  track.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", render);
  render();
</script>
